{
  "name": "order-delivery-api",
  "version": "1.0.0",
  "description": "Multi-vendor Order Placement & Delivery REST API (Cash on Delivery)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "test:payment": "node scripts/run-payment-tests.js",
    "test:payment:manual:setup": "node scripts/run-manual-case.js setup",
    "test:payment:manual:verify": "node scripts/run-manual-case.js verify"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^4.6.0",
    "pg": "^8.13.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "stripe": "^23.0.1"
  },
  "devDependencies": {
    "newman": "^6.2.3",
    "newman-reporter-htmlextra": "^1.23.1",
    "nodemon": "^3.1.9",
    "sequelize-cli": "^6.6.2"
  }
}
